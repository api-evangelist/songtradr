        {
          "info": {
            "name": "Update password by using the password reset token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.songtradr.com/api/v1/user/update-password",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update password by using the password reset token"
        },
        {
          "info": {
            "name": "Generates a new JWT token for the given refresh token",
